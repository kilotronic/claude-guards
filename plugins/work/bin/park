"""The `park` command (`park resume <n>`). Claude Code puts this plugin's bin/ on PATH; the code is in ../scripts/park.py."""

import os
import sys

sys.path.insert(
    0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "scripts")
)

from park import main

sys.exit(main(sys.argv[1:]))
