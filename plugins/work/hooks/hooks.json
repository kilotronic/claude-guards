{
  "description": "Lets an agent run a plain gh pr merge in auto mode, never with --admin or --body-file",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/allow-merge.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
