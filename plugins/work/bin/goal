"""`goal`, the old name of `next-item`: it says so on stderr, then runs exactly as `next-item` does. It goes
away in a later release, once every repo calls `next-item`."""

import os
import sys

sys.path.insert(
    0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "scripts")
)

from goal import main

print("`goal` is now `next-item`; `goal` goes away in a later release", file=sys.stderr)
sys.exit(main())
